{
  "version": 1,
  "author": "Alarm V1",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds3231", "id": "rtc1", "top": -120, "left": -180, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 120, "left": -180, "attrs": { "color": "green", "label": "WAKE" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "rtc1:VCC", "esp:3V3", "red", [ "h0" ] ],
    [ "rtc1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "rtc1:SDA", "esp:21", "blue", [ "h0" ] ],
    [ "rtc1:SCL", "esp:22", "yellow", [ "h0" ] ],
    [ "rtc1:SQW", "esp:33", "orange", [ "h0" ] ],
    [ "btn1:1.l", "esp:32", "green", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}